    "@lexops/govlink": "workspace:*",
    "@lexops/hilap": "workspace:*",
    "@lexops/lexi": "workspace:*",
    "@lexops/persistence": "workspace:*",
    "@lexops/rule-engine": "workspace:*",
    "@lexops/sade": "workspace:*",
    "@lexops/shared": "workspace:*",
    "@lexops/spe": "workspace:*",
    "@lexops/zatca": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
