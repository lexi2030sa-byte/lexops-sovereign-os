{
  "name": "@lexops/backend",
  "version": "0.1.0",
  "private": true,
  "description": "LexOps Backend — NestJS Modular Monolith (USDS-02)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
